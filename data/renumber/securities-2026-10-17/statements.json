  "SELECT 1 / (CASE WHEN (SELECT count(*) FROM legal_articles WHERE \"lawName\" = 'نظام السوق المالية') = 68 THEN 1 ELSE 0 END) AS guard_count",
  "SELECT 1 / (CASE WHEN NOT EXISTS (SELECT 1 FROM renumber_plan p LEFT JOIN legal_articles a ON a.id = p.id AND a.\"lawName\" = 'نظام السوق المالية' AND a.\"articleNumber\" = p.current_number AND a.\"articleBis\" = 0 WHERE a.id IS NULL) THEN 1 ELSE 0 END) AS guard_rows",
  "UPDATE legal_articles a SET \"articleNumber\" = a.\"articleNumber\" + 100000 FROM renumber_plan p WHERE a.id = p.id AND (p.new_number <> p.current_number OR p.new_bis <> 0)",
  "UPDATE legal_articles a SET \"articleNumber\" = p.new_number, \"articleBis\" = p.new_bis FROM renumber_plan p WHERE a.id = p.id AND a.\"articleNumber\" >= 100000",
  "SELECT 1 / (CASE WHEN NOT EXISTS (SELECT 1 FROM renumber_plan p JOIN legal_articles a ON a.id = p.id WHERE a.\"articleNumber\" <> p.new_number OR a.\"articleBis\" <> p.new_bis) THEN 1 ELSE 0 END) AS guard_after"
