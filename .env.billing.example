# ─────────────────────────────────────────────────────────────────────────────
# متغيّرات منظومة الفوترة — HKM-BILLING-UX-001
# انسخ ما يلزم إلى بيئتك (Vercel/Render). لا تودِع أي سرّ في المستودع.
# كل شيء مُعطّل افتراضيًا؛ لا تفعيل إنتاجي قبل المراحل والاختبارات.
# ─────────────────────────────────────────────────────────────────────────────

# ── مزوّد الدفع (قابل للاستبدال) ──
PAYMENT_PROVIDER=moyasar
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=
PAYMENT_WEBHOOK_URL=

# ── العملة والضريبة ──
BILLING_CURRENCY=SAR
VAT_RATE_BPS=1500

# ── وحدة النقاط (النقطة = 1000 milli-unit في محرك v2) ──
POINTS_PER_MILLI=1000

# ── بيانات المنشأة (للفواتير الضريبية / ZATCA) ──
COMPANY_VAT_NUMBER=
COMPANY_LEGAL_NAME_AR=
COMPANY_LEGAL_NAME_EN=
COMPANY_CR_NUMBER=
COMPANY_ADDRESS_JSON={}

# ── الترحيل ──
# منح المستخدمين الحاليين رصيدًا عند التفعيل (0 = لا منح). يُسجَّل كمصدر LEGACY_MIGRATION.
LEGACY_USER_GRANT_POINTS=0

# ── أعلام الطرح المرحلي (كلها false حتى اكتمال كل مرحلة واختباراتها) ──
BILLING_ENABLED=false
CREDITS_ENFORCEMENT_ENABLED=false
PAID_CHECKOUT_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
AUTO_RENEWAL_ENABLED=false
ZATCA_INTEGRATION_ENABLED=false

# علم محرك وحدات v2 القائم (يبقى كما هو حتى تعميم الإنفاذ).
USAGE_CREDITS_V2=false
