{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hakeem.local/schema/package-manifest.json",
  "title": "Hakeem Package Manifest (§16)",
  "type": "object",
  "required": ["id", "name", "version", "schemaVersion", "publisher", "kind", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "schemaVersion": { "type": "string" },
    "publisher": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["domain", "institution"] },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "compatibility": { "type": "object" },
    "entrypoints": { "type": "object" },
    "signatures": { "type": "array" }
  }
}
