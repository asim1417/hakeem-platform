<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.hakeem.rasd-agent</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/npx</string>
      <string>tsx</string>
      <string>/opt/hakeem-rasd-agent/src/cli.ts</string>
      <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
  </dict>
</plist>
